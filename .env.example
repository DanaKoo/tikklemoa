# 실제 값은 Vercel 프로젝트 > Settings > Environment Variables 에만 넣는다. 이 파일에는 값을 채우지 않는다.

# Supabase (Project Settings > API)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Resend (API Keys). MAIL_FROM은 Resend에서 인증한 도메인 주소. 예: 티끌모아 <report@your-domain.com>
RESEND_API_KEY=
MAIL_FROM=

# 아무 긴 무작위 문자열 (예: openssl rand -base64 32)
UNSUBSCRIBE_SECRET=
CRON_SECRET=

# 메일 속 링크의 기준 주소
SITE_URL=https://tikklemoa.vercel.app

# 선택: 한 번 실행에 보낼 최대 메일 수 (Resend 무료 하루 100통)
REPORT_MAX_PER_RUN=90
